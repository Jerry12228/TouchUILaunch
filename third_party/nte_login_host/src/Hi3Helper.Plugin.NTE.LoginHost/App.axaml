<Application x:Class="Nte.LoginHost.App"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             RequestedThemeVariant="Light">
  <Application.Styles>
    <FluentTheme />
    <Style Selector="ScrollBar">
      <Setter Property="Theme" Value="{DynamicResource LoginScrollBarTheme}" />
    </Style>
  </Application.Styles>
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Nte.LoginHost/Styles/Login.axaml" />
        <ResourceInclude Source="avares://Nte.LoginHost/Styles/ScrollBars.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
</Application>
